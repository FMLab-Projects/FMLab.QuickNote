<Project>

  <!-- Versão central do produto (aplicada a todos os projetos da solução).
       Enquanto o app não atinge uma v1 estável, o VersionSuffix "beta" fica
       fixo — bump do VersionPrefix a cada release notável. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
  </PropertyGroup>

  <!-- Identidade do produto/empresa, aplicada a todos os projetos (metadados do
       executável no Windows Explorer, tela de Sobre, pacotes etc). -->
  <PropertyGroup>
    <Product>FMLab.QuickNote</Product>
    <Company>FMLab</Company>
    <Authors>FMLab</Authors>
    <Copyright>© $([System.DateTime]::Now.Year) FMLab</Copyright>
  </PropertyGroup>

</Project>
