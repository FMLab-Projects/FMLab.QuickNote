<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:FMLab.QuickNote.App"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="520"
        x:Class="FMLab.QuickNote.App.HistoryWindow"
        Title="Histórico — FMLab.QuickNote"
        Width="420" Height="520"
        MinWidth="320" MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <TextBlock x:Name="FooterText"
                       DockPanel.Dock="Bottom"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       Margin="0,8,0,0" />
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         PlaceholderText="Buscar..."
                         Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="Filtro:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="FilterComboBox" Grid.Column="2" Width="140" SelectedIndex="0">
                    <ComboBoxItem>Todas</ComboBoxItem>
                    <ComboBoxItem>Ativas</ComboBoxItem>
                    <ComboBoxItem>Concluídas</ComboBoxItem>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="EmptyStateText"
                       DockPanel.Dock="Top"
                       Text="Nenhuma nota encontrada."
                       Foreground="#AAAAAA"
                       Margin="0,8"
                       IsVisible="False" />
            <ListBox x:Name="NotesListBox" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="app:NoteListItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusLine}"
                                           Foreground="#AAAAAA"
                                           FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Reabrir"
                                    Margin="6,0"
                                    Click="OnReopenClick"
                                    Tag="{Binding}" />
                            <Button Grid.Column="2"
                                    Content="{Binding ToggleActionLabel}"
                                    Click="OnToggleCompletionClick"
                                    Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
