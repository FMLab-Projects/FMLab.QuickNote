<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="480"
        x:Class="FMLab.QuickNote.App.NoteWindow"
        x:Name="Root"
        Title="FMLab.QuickNote"
        Width="380" Height="480"
        MinWidth="260" MinHeight="180"
        CanResize="True"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <TextBox x:Name="TitleTextBox"
                     DockPanel.Dock="Top"
                     TextWrapping="NoWrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="0,0,0,6"
                     PlaceholderText="Título (opcional)" />
            <StackPanel x:Name="CommentsPanel" DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,0">
                <TextBlock Text="Comentários"
                           Foreground="#888888"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommentsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#CCCCCC"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="CommentTextBox"
                             Grid.Column="0"
                             MaxLength="140"
                             Background="Transparent"
                             BorderThickness="0,1,0,0"
                             BorderBrush="#3A3A3A"
                             Foreground="White"
                             FontSize="12"
                             Padding="0,4"
                             PlaceholderText="Adicionar comentário..."
                             KeyDown="OnCommentTextBoxKeyDown" />
                    <TextBlock x:Name="CommentCounterText"
                               Grid.Column="1"
                               Text="140"
                               Foreground="#777777"
                               FontSize="10"
                               VerticalAlignment="Bottom"
                               Margin="6,0,0,4" />
                </Grid>
            </StackPanel>
            <TextBox x:Name="BodyTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     PlaceholderText="Digite aqui..." />
        </DockPanel>
    </Border>
</Window>
