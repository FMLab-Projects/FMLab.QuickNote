<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:FMLab.QuickNote.App"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="420"
        x:Class="FMLab.QuickNote.App.HelpWindow"
        Title="Atalhos de teclado — FMLab.QuickNote"
        Width="380" Height="420"
        MinWidth="320" MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="Atalhos de teclado"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top"
                       Text="Atalhos &quot;Global&quot; funcionam mesmo com a janela escondida; os demais exigem que a janela esteja em foco. Para remapear, use Configurações."
                       Foreground="#AAAAAA"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <Button DockPanel.Dock="Bottom"
                    x:Name="CloseButton"
                    Content="Fechar"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Click="OnCloseClick" />
            <ScrollViewer>
                <ItemsControl x:Name="ShortcutsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="app:ShortcutRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ActionLabel}"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ComboText}"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"
                                           Margin="6,0"
                                           MinWidth="100" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ScopeLabel}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           MinWidth="70" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
