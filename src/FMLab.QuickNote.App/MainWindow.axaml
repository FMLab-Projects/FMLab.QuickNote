<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="480"
        x:Class="FMLab.QuickNote.App.MainWindow"
        x:Name="Root"
        Title="FMLab.QuickNote"
        Width="380" Height="480"
        CanResize="False"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="FMLab.QuickNote — spike Fase 1 (Esc esconde a janela)"
                       Foreground="#9A9A9A"
                       FontSize="11"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <TextBox x:Name="BodyTextBox"
                     DockPanel.Dock="Bottom"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     PlaceholderText="Digite aqui..." />
        </DockPanel>
    </Border>
</Window>
