<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="280"
        x:Class="FMLab.QuickNote.App.AboutWindow"
        Title="Sobre — FMLab.QuickNote"
        Width="320" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="16">
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Bottom"
                    x:Name="CloseButton"
                    Content="Fechar"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Click="OnCloseClick" />
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <Image x:Name="AppIcon"
                       Width="64" Height="64"
                       Margin="0,0,0,8" />
                <TextBlock x:Name="AppNameText"
                           Text="FMLab.QuickNote"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CompanyText"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
                <TextBlock Text="Captura rápida de notas via atalho de teclado global."
                           Foreground="#AAAAAA"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="CopyrightText"
                           Foreground="#888888"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
