<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:FMLab.QuickNote.App"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="500"
        x:Class="FMLab.QuickNote.App.SettingsWindow"
        Title="Configurações — FMLab.QuickNote"
        Width="440" Height="500"
        MinWidth="360" MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#1E1E1E">
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <CheckBox x:Name="AutostartCheckBox"
                      DockPanel.Dock="Top"
                      Content="Iniciar com o sistema operacional"
                      Foreground="White"
                      Margin="0,0,0,12"
                      Click="OnAutostartClick" />
            <TextBlock DockPanel.Dock="Top"
                       Text="Atalhos"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <Button DockPanel.Dock="Bottom"
                    x:Name="SaveButton"
                    Content="Salvar atalhos"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Click="OnSaveClick" />
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Bottom"
                       Foreground="#FF8080"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="False" />
            <ItemsControl x:Name="ShortcutsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="app:ShortcutRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActionLabel}" Foreground="White" />
                                <TextBlock Text="{Binding ConflictMessage}"
                                           Foreground="#FF8080"
                                           FontSize="11"
                                           IsVisible="{Binding HasConflict}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ComboText}"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       Margin="6,0"
                                       MinWidth="120" />
                            <Button Grid.Column="2"
                                    Content="Capturar"
                                    Click="OnCaptureClick"
                                    Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
